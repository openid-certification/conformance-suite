{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$comment": "Validates the data of the registrar_dataset element of issuer_info, ETSI TS 119 472-3 ISS-MDATA-REG_CERT-4.2.3-09 to -13. The members are the registry attributes of ETSI TS 119 475 Annex B: identifier (B.2.2, an array of B.2.5 Identifier objects), srvDescription (B.2.1, MultiLangString objects of B.2.6), registryURI (B.2.1) and providesAttestations (B.2.1, B.2.9 Credential objects). The other optional members are the remaining WalletRelyingParty (B.2.1) and LegalEntity (B.2.2) attributes, so a registrar that provides more of the register is not reported.",
    "definitions": {
        "MultiLangString": {
            "type": "object",
            "properties": {
                "lang": { "type": "string", "minLength": 1 },
                "content": { "type": "string", "minLength": 1 }
            },
            "required": ["lang", "content"],
            "additionalProperties": false
        },
        "MultiLangStrings": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/MultiLangString" }
        },
        "Identifier": {
            "type": "object",
            "properties": {
                "type": { "type": "string", "minLength": 1 },
                "identifier": { "type": "string", "minLength": 1 }
            },
            "required": ["type", "identifier"],
            "additionalProperties": false
        },
        "Claim": {
            "type": "object",
            "properties": {
                "path": { "type": "array", "minItems": 1 },
                "values": { "type": "array", "minItems": 1 }
            },
            "required": ["path"],
            "additionalProperties": false
        },
        "Credential": {
            "type": "object",
            "properties": {
                "format": { "type": "string", "minLength": 1 },
                "meta": { "type": "object" },
                "claim": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/definitions/Claim" }
                }
            },
            "required": ["format", "meta"],
            "additionalProperties": false
        }
    },
    "type": "object",
    "properties": {
        "identifier": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/Identifier" }
        },
        "srvDescription": { "$ref": "#/definitions/MultiLangStrings" },
        "registryURI": { "type": "string", "format": "uri" },
        "providesAttestations": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/Credential" }
        },
        "tradeName": { "type": "string" },
        "supportURI": { "type": "array", "items": { "type": "string" } },
        "isPSB": { "type": "boolean" },
        "entitlement": { "type": "array", "items": { "type": "string" } },
        "supervisoryAuthority": { "type": "object" },
        "usesIntermediary": { "type": "array" },
        "intendedUse": { "type": "array" },
        "legalPerson": { "type": "object" },
        "naturalPerson": { "type": "object" },
        "postalAddress": { "type": "string" },
        "country": { "type": "string" },
        "email": { "type": "array", "items": { "type": "string" } },
        "phone": { "type": "array", "items": { "type": "string" } },
        "infoURI": { "type": "array", "items": { "type": "string" } }
    },
    "required": ["identifier", "srvDescription", "registryURI", "providesAttestations"],
    "additionalProperties": false
}
