{
    "alias": "ssf-rx-test-ci",
    "description": "SSF Receiver test by emulating an SSF Transmitter",
    "ssf": {
        "stream": {
            "audience": "{BASEURL}test/a/ssf-tx-test-ci"
        },
        "subjects": {
            "valid": [
                {
                    "format": "email",
                    "email": "ssf-ci-user@example.com"
                },
                {
                    "format": "iss_sub",
                    "iss": "https://idp.example.com",
                    "sub": "ssf-ci-user"
                },
                {
                    "format": "complex",
                    "user": {
                        "format": "email",
                        "email": "ssf-ci-user@example.com"
                    },
                    "tenant": {
                        "format": "iss_sub",
                        "iss": "https://idp.example.com",
                        "sub": "tenant-1"
                    }
                }
            ]
        },
        "transmitter": {
            "access_token": "abc1234"
        }
    }
}
