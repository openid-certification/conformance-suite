{
    "alias": "oidf-vp-test-wallet",
    "description": "OID4VP RP against OP (verifier test - HAIP)",
    "client": {
        "request_object_trust_anchor_pem": "{vp-signing-ca.crt}"
    },
    "credential": {
        "signing_jwk": {vp-signing-jwk.json}
    },
    "browser": [
        {
            "comment": "visit the paired wallet test's redirect_uri (its callback endpoint), standing in for the tester's browser completing the verifier's session",
            "match": "https://*/test/a/*/callback*",
            "tasks": [
                {
                    "task": "Visit wallet-test callback",
                    "match": "https://*/test/a/*/callback*",
                    "commands": [
                        [
                            "wait",
                            "id",
                            "submission_complete",
                            10
                        ]
                    ]
                }
            ]
        },
        {
            "comment": "capture the suite-served evidence page to fill the verification-result screenshot placeholder without human interaction",
            "match": "https://*/test/a/*/verification-evidence",
            "tasks": [
                {
                    "task": "Capture verification evidence",
                    "match": "https://*/test/a/*/verification-evidence",
                    "commands": [
                        [
                            "wait",
                            "xpath",
                            "//*",
                            10,
                            ".*Deferred verification evidence.*",
                            "update-image-placeholder"
                        ]
                    ]
                }
            ]
        }
    ]
}
